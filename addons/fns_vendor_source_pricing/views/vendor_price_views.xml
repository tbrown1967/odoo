<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="vendor_price_list" model="ir.ui.view">
        <field name="name">fns.vendor.price.list</field>
        <field name="model">fns.vendor.price</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="effective_date"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="vendor_sku"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="map_price"/>
                <field name="dealer_price"/>
                <field name="sheet_id" optional="show"/>
                <field name="source_note" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="vendor_price_search" model="ir.ui.view">
        <field name="name">fns.vendor.price.search</field>
        <field name="model">fns.vendor.price</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="vendor_sku"/>
                <field name="partner_id"/>
                <field name="sheet_id"/>
                <group>
                    <filter name="group_sheet" string="Price Sheet" context="{'group_by': 'sheet_id'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="vendor_price_action" model="ir.actions.act_window">
        <field name="name">Vendor Source Prices</field>
        <field name="res_model">fns.vendor.price</field>
        <field name="view_mode">list</field>
    </record>

    <record id="vendor_price_sheet_list" model="ir.ui.view">
        <field name="name">fns.vendor.price.sheet.list</field>
        <field name="model">fns.vendor.price.sheet</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="effective_date"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>
    <record id="vendor_price_sheet_form" model="ir.ui.view">
        <field name="name">fns.vendor.price.sheet.form</field>
        <field name="model">fns.vendor.price.sheet</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(vendor_price_action)d" type="action" class="oe_stat_button"
                                icon="fa-tags" context="{'search_default_sheet_id': id}">
                            <field name="line_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="effective_date"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="source_document"/>
                            <field name="source_sha256"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="vendor_price_sheet_action" model="ir.actions.act_window">
        <field name="name">Vendor Price Sheets</field>
        <field name="res_model">fns.vendor.price.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
