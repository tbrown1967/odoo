<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_source_prices_form" model="ir.ui.view">
        <field name="name">product.template.diverite.source.prices.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="diverite_source_prices" string="Dive Rite Source Pricing"
                      groups="base.group_user" invisible="not x_fns_diverite_source">
                    <group>
                        <field name="x_fns_diverite_map_price" digits="[16, 2]"/>
                        <field name="x_fns_diverite_partner_price" digits="[16, 2]"/>
                        <field name="x_fns_diverite_source"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_source_prices_list" model="ir.ui.view">
        <field name="name">product.template.diverite.source.prices.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="x_fns_diverite_map_price" digits="[16, 2]" optional="hide" groups="base.group_user"/>
                <field name="x_fns_diverite_partner_price" digits="[16, 2]" optional="hide" groups="base.group_user"/>
                <field name="x_fns_diverite_source" optional="hide" groups="base.group_user"/>
            </field>
        </field>
    </record>
</odoo>
